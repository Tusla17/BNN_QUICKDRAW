set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY bdscnn_ecg_tb
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "12:34:33  JUNE 25, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_location_assignment PIN_P11 -to clk
set_location_assignment PIN_C10 -to rst_n
set_location_assignment PIN_C11 -to start
set_location_assignment PIN_A8 -to ledr[0]
set_location_assignment PIN_A9 -to ledr[1]
set_location_assignment PIN_A10 -to ledr[2]
set_location_assignment PIN_B10 -to ledr[3]
set_location_assignment PIN_D14 -to ledr[7]
set_location_assignment PIN_D13 -to ledr[4]
set_global_assignment -name SYSTEMVERILOG_FILE bdscnn_ecg_tb.sv
set_global_assignment -name SYSTEMVERILOG_FILE hw_stimulus.sv
set_global_assignment -name SDC_FILE bdscnn_ecg.sdc
set_global_assignment -name SYSTEMVERILOG_FILE fc1_folded_top_test.sv
set_global_assignment -name SYSTEMVERILOG_FILE uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE bdscnn_ecg.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc1_folded_neuron.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc1_folded_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc1_constants.sv
set_global_assignment -name SYSTEMVERILOG_FILE dw_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc1_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc1_neuron.sv
set_global_assignment -name SYSTEMVERILOG_FILE mcp_pe.sv
set_global_assignment -name SYSTEMVERILOG_FILE bdscnn_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc2_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE popcount.sv
set_global_assignment -name SYSTEMVERILOG_FILE window3x3s1.sv
set_global_assignment -name SYSTEMVERILOG_FILE mcp_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE pw_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE window4x4s2.sv
set_global_assignment -name SYSTEMVERILOG_FILE pw_pe.sv
set_global_assignment -name SYSTEMVERILOG_FILE dw_pe.sv
set_global_assignment -name SOURCE_FILE db/bdscnn_top.cmp.rdb
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name POWER_USE_INPUT_FILES ON
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE 12.5%
set_global_assignment -name POWER_INPUT_FILE_NAME ../sim/simulation_power.vcd -section_id simulation_power.vcd
set_instance_assignment -name POWER_READ_INPUT_FILE simulation_power.vcd -to bdscnn_ecg_tb
set_global_assignment -name FLOW_ENABLE_POWER_ANALYZER ON
set_global_assignment -name POWER_REPORT_SIGNAL_ACTIVITY ON
set_global_assignment -name POWER_REPORT_POWER_DISSIPATION ON
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top